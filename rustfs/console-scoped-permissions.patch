+
+const personalNamespacePolicy = JSON.stringify({
+  Version: "2012-10-17",
+  Statement: [
+    {
+      Effect: "Allow",
+      Action: ["s3:CreateBucket", "s3:DeleteBucket", "s3:GetBucketCors", "s3:PutBucketCors", "s3:PutBucketVersioning"],
+      Resource: ["arn:aws:s3:::${jwt:preferred_username}-*"],
+    },
+    {
+      Effect: "Allow",
+      Action: ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
+      Resource: ["arn:aws:s3:::${jwt:preferred_username}-*/*"],
+    },
+  ],
+})
+
+function makePersonalApi(username: unknown): Api {
+  return {
+    async get(path) {
+      if (path === "/is-admin" || path === "/account/info") return { is_admin: false }
+      return { policy: personalNamespacePolicy, username }
+    },
+  }
+}
+
+test("OIDC username resources enable own-bucket and object controls without cross-user access", async (t) => {
+  const mounted = await mountPermissions(t, makePersonalApi("alice"))
+  assert.equal(mounted.permissions.canCapability("bucket.create"), true)
+  for (const capability of ["bucket.create", "bucket.delete", "bucket.cors.edit", "bucket.versioning.edit"] as const) {
+    assert.equal(mounted.permissions.canCapability(capability, { bucket: "alice-photos" }), true)
+    assert.equal(mounted.permissions.canCapability(capability, { bucket: "alice2-photos" }), false)
+    assert.equal(mounted.permissions.canCapability(capability, { bucket: "bob-photos" }), false)
+  }
+  for (const capability of ["objects.upload", "objects.download", "objects.delete", "objects.copy"] as const) {
+    assert.equal(mounted.permissions.canCapability(capability, { bucket: "alice-photos", objectKey: "file" }), true)
+    assert.equal(mounted.permissions.canCapability(capability, { bucket: "bob-photos", objectKey: "file" }), false)
+  }
+  assert.equal(mounted.permissions.canCapability("bucket.policy.edit", { bucket: "alice-photos" }), false)
+})
+
+for (const username of [undefined, "", " ", 42, "*", "alice?", "${jwt:sub}"]) {
+  test(`invalid or missing OIDC username does not enable scoped controls: ${JSON.stringify(username)}`, async (t) => {
+    const mounted = await mountPermissions(t, makePersonalApi(username))
+    assert.equal(mounted.permissions.canCapability("bucket.create"), false)
+    assert.equal(mounted.permissions.canCapability("bucket.create", { bucket: "alice-photos" }), false)
+    assert.equal(mounted.permissions.canCapability("bucket.create", { bucket: "-photos" }), false)
+    assert.equal(
+      mounted.permissions.canCapability("objects.download", { bucket: "alice-photos", objectKey: "file" }),
+      false,
+    )
+  })
+}
+
+test("a new session replaces the previous username's capability context", async (t) => {
+  const mounted = await mountPermissions(t, makePersonalApi("alice"))
+  assert.equal(mounted.permissions.canCapability("bucket.create", { bucket: "alice-photos" }), true)
+  await mounted.changeCredentials(
+    { AccessKeyId: "second", SecretAccessKey: "other", SessionToken: "new-token" },
+    makePersonalApi("bob"),
+  )
+  assert.equal(mounted.permissions.canCapability("bucket.create", { bucket: "alice-photos" }), false)
+  assert.equal(mounted.permissions.canCapability("bucket.create", { bucket: "bob-photos" }), true)
+})
