diff --git a/tests/lib/scoped-bucket-capabilities.test.ts b/tests/lib/scoped-bucket-capabilities.test.ts
new file mode 100644
index 0000000..1f0de12
--- /dev/null
+++ b/tests/lib/scoped-bucket-capabilities.test.ts
@@ -0,0 +1,123 @@
+import test from "node:test"
+import assert from "node:assert/strict"
+import { hasConsoleCapability } from "../../lib/permission-capabilities"
+import {
+  hasConsolePermission,
+  resolveConsolePolicyUsername,
+  type ConsolePolicy,
+  type ConsoleStatement,
+} from "../../lib/console-policy-parser"
+
+const policy = (...Statement: ConsoleStatement[]): ConsolePolicy => ({ Version: "2012-10-17", Statement })
+const createGrant: ConsoleStatement = {
+  Effect: "Allow",
+  Action: ["s3:CreateBucket"],
+  Resource: ["arn:aws:s3:::alice-*"],
+}
+
+test("a bucket-prefix grant exposes the create dialog without granting all buckets", () => {
+  assert.equal(hasConsoleCapability(policy(createGrant), "bucket.create"), true)
+})
+
+test("creation is checked against the actual bucket once a name is supplied", () => {
+  assert.equal(hasConsoleCapability(policy(createGrant), "bucket.create", { bucket: "alice-photos" }), true)
+  for (const bucket of ["alice2-photos", "bob-photos", "alice", "unrelated"]) {
+    assert.equal(hasConsoleCapability(policy(createGrant), "bucket.create", { bucket }), false)
+  }
+})
+
+test("an exact bucket grant also exposes creation", () => {
+  const exact = policy({ ...createGrant, Resource: ["arn:aws:s3:::alice-photos"] })
+  assert.equal(hasConsoleCapability(exact, "bucket.create"), true)
+  assert.equal(hasConsoleCapability(exact, "bucket.create", { bucket: "alice-photos" }), true)
+  assert.equal(hasConsoleCapability(exact, "bucket.create", { bucket: "alice-backups" }), false)
+})
+
+test("read-only and object-only grants do not expose creation", () => {
+  assert.equal(hasConsoleCapability(policy({ ...createGrant, Action: ["s3:ListBucket"] }), "bucket.create"), false)
+  assert.equal(
+    hasConsoleCapability(policy({ ...createGrant, Resource: ["arn:aws:s3:::alice-*/*"] }), "bucket.create"),
+    false,
+  )
+})
+
+test("global and complete-prefix denies still suppress creation", () => {
+  for (const Resource of [["*"], ["arn:aws:s3:::*"], ["arn:aws:s3:::alice-*"]]) {
+    const denied = policy(createGrant, { Effect: "Deny", Action: ["s3:CreateBucket"], Resource })
+    assert.equal(hasConsoleCapability(denied, "bucket.create"), false)
+    assert.equal(hasConsoleCapability(denied, "bucket.create", { bucket: "alice-photos" }), false)
+  }
+})
+
+test("a denied bucket does not hide creation elsewhere in an allowed prefix", () => {
+  const scoped = policy(createGrant, {
+    Effect: "Deny",
+    Action: ["s3:CreateBucket"],
+    Resource: ["arn:aws:s3:::alice-private"],
+  })
+  assert.equal(hasConsoleCapability(scoped, "bucket.create"), true)
+  assert.equal(hasConsoleCapability(scoped, "bucket.create", { bucket: "alice-photos" }), true)
+  assert.equal(hasConsoleCapability(scoped, "bucket.create", { bucket: "alice-private" }), false)
+})
+
+test("NotResource exceptions are considered for creation discovery and named checks", () => {
+  const scoped = policy(
+    { ...createGrant, Resource: ["*"] },
+    { Effect: "Deny", Action: ["s3:CreateBucket"], NotResource: ["arn:aws:s3:::alice-*"] },
+  )
+  assert.equal(hasConsoleCapability(scoped, "bucket.create"), true)
+  assert.equal(hasConsoleCapability(scoped, "bucket.create", { bucket: "alice-photos" }), true)
+  assert.equal(hasConsoleCapability(scoped, "bucket.create", { bucket: "bob-photos" }), false)
+})
+
+test("NotAction cannot be bypassed by creation discovery", () => {
+  assert.equal(hasConsoleCapability(policy({ ...createGrant, NotAction: ["s3:CreateBucket"] }), "bucket.create"), false)
+  assert.equal(
+    hasConsoleCapability(
+      policy(createGrant, { Effect: "Deny", NotAction: ["s3:ListBucket"], Resource: ["*"] }),
+      "bucket.create",
+    ),
+    false,
+  )
+})
+
+test("unresolved resource variables never act as creation candidates", () => {
+  assert.equal(
+    hasConsoleCapability(
+      policy({ ...createGrant, Resource: ["arn:aws:s3:::${jwt:preferred_username}-*"] }),
+      "bucket.create",
+    ),
+    false,
+  )
+})
+
+test("existing unrestricted creation grants retain their behavior", () => {
+  const unrestricted = policy({ ...createGrant, Resource: ["arn:aws:s3:::*"] })
+  assert.equal(hasConsoleCapability(unrestricted, "bucket.create"), true)
+  assert.equal(hasConsoleCapability(unrestricted, "bucket.create", { bucket: "arbitrary-bucket" }), true)
+})
+
+test("username resolution preserves the source policy and applies to exclusions", () => {
+  const original = policy(
+    { ...createGrant, Resource: ["arn:aws:s3:::${jwt:preferred_username}-*"] },
+    {
+      Effect: "Deny",
+      Action: ["s3:CreateBucket"],
+      NotResource: ["arn:aws:s3:::${jwt:preferred_username}-photos"],
+    },
+  )
+  const before = JSON.stringify(original)
+  const resolved = resolveConsolePolicyUsername(original, "alice")
+  assert.equal(JSON.stringify(original), before)
+  assert.equal(hasConsoleCapability(resolved, "bucket.create", { bucket: "alice-photos" }), true)
+  assert.equal(hasConsoleCapability(resolved, "bucket.create", { bucket: "alice-backups" }), false)
+  assert.equal(hasConsoleCapability(resolved, "bucket.create", { bucket: "bob-photos" }), false)
+})
+
+test("unknown variables are not turned into wildcards or guessed from the username", () => {
+  const original = policy({ ...createGrant, Resource: ["arn:aws:s3:::${jwt:sub}-*"] })
+  const resolved = resolveConsolePolicyUsername(original, "alice")
+  assert.deepEqual(resolved.Statement[0]?.Resource, ["arn:aws:s3:::${jwt:sub}-*"])
+  assert.equal(hasConsoleCapability(resolved, "bucket.create"), false)
+  assert.equal(hasConsolePermission(resolved, "s3:CreateBucket", "arn:aws:s3:::alice-photos"), false)
+})
diff --git a/tests/lib/scoped-bucket-form.test.ts b/tests/lib/scoped-bucket-form.test.ts
new file mode 100644
index 0000000..6fa9934
--- /dev/null
+++ b/tests/lib/scoped-bucket-form.test.ts
@@ -0,0 +1,181 @@
+import test, { type TestContext } from "node:test"
+import assert from "node:assert/strict"
+import { readFileSync } from "node:fs"
+import * as React from "react"
+import { createRoot } from "react-dom/client"
+import { Window } from "happy-dom"
+import ts from "typescript"
+import { hasConsoleCapability } from "../../lib/permission-capabilities"
+import type { ConsoleCapability } from "../../lib/permission-capabilities"
+import type { PermissionResourceContext } from "../../lib/permission-resources"
+import type { ConsolePolicy } from "../../lib/console-policy-parser"
+
+const mocksKey = Symbol.for("scoped-bucket-form")
+const source = ts.transpileModule(
+  readFileSync(new URL("../../components/buckets/new-form.tsx", import.meta.url), "utf8"),
+  { compilerOptions: { module: ts.ModuleKind.ESNext, jsx: ts.JsxEmit.ReactJSX } },
+).outputText
+const testSource = source.replace(/import (.*?) from "([^"]+)";/gs, (statement, bindings, specifier: string) => {
+  if ((!specifier.startsWith("@/") && specifier !== "react-i18next") || specifier === "@/lib/bucket-name") {
+    const url = specifier.startsWith("@/")
+      ? new URL(`../../${specifier.slice(2)}.ts`, import.meta.url).href
+      : import.meta.resolve(specifier)
+    return `import ${bindings} from "${url}";`
+  }
+  const stub = bindings
+    .replace(/[{}\s]/g, "")
+    .split(",")
+    .filter(Boolean)
+    .map(
+      (name: string) =>
+        `export const ${name} = (...args) => globalThis[Symbol.for("scoped-bucket-form")]["${name}"](...args);`,
+    )
+    .join("\n")
+  return statement.replace(specifier, `data:text/javascript,${encodeURIComponent(stub)}`)
+})
+const { BucketNewForm } = (await import(
+  `data:text/javascript,${encodeURIComponent(testSource)}`
+)) as typeof import("../../components/buckets/new-form")
+
+async function mountForm(t: TestContext) {
+  const browser = new Window()
+  const globals = { window: browser, document: browser.document, IS_REACT_ACT_ENVIRONMENT: true }
+  const descriptors = Object.keys(globals).map(
+    (key) => [key, Object.getOwnPropertyDescriptor(globalThis, key)] as const,
+  )
+  for (const [key, value] of Object.entries(globals)) {
+    Object.defineProperty(globalThis, key, { configurable: true, writable: true, value })
+  }
+
+  const policy: ConsolePolicy = {
+    Version: "2012-10-17",
+    Statement: [{ Effect: "Allow", Action: ["s3:CreateBucket"], Resource: ["arn:aws:s3:::alice-*"] }],
+  }
+  const errors: string[] = []
+  const requests: { Bucket: string; ObjectLockEnabledForBucket?: boolean }[] = []
+  let submit: (() => Promise<void>) | undefined
+  let changeName: ((event: { target: { value: string } }) => void) | undefined
+  let submitDisabled = true
+  const passthrough = ({ children }: { children?: React.ReactNode }) => React.createElement("div", null, children)
+  Reflect.set(globalThis, mocksKey, {
+    useTranslation: () => ({ t: (key: string) => key }),
+    useMessage: () => ({
+      error: (message: string) => errors.push(message),
+      success: () => {},
+    }),
+    usePermissions: () => ({
+      canCapability: (capability: ConsoleCapability, context?: PermissionResourceContext) =>
+        hasConsoleCapability(policy, capability, context),
+    }),
+    useBucket: () => ({
+      createBucket: async (request: { Bucket: string; ObjectLockEnabledForBucket?: boolean }) => {
+        requests.push(request)
+      },
+      putBucketVersioning: () => assert.fail("Unrequested versioning update"),
+      putObjectLockConfiguration: () => assert.fail("Unrequested object-lock update"),
+      putBucketQuota: () => assert.fail("Unrequested quota update"),
+    }),
+    Button: ({
+      children,
+      variant,
+      disabled,
+      onClick,
+    }: {
+      children?: React.ReactNode
+      variant: string
+      disabled?: boolean
+      onClick: () => Promise<void>
+    }) => {
+      if (variant === "default") {
+        submit = onClick
+        submitDisabled = !!disabled
+      }
+      return React.createElement("button", { disabled, onClick }, children)
+    },
+    Input: ({
+      id,
+      value,
+      onChange,
+    }: {
+      id?: string
+      value: string
+      onChange: (event: { target: { value: string } }) => void
+    }) => {
+      if (id === "bucket-name") changeName = onChange
+      return React.createElement("input", { id, value, readOnly: true })
+    },
+    Alert: passthrough,
+    AlertDescription: passthrough,
+    AlertTitle: passthrough,
+    Field: passthrough,
+    FieldContent: passthrough,
+    FieldLabel: passthrough,
+    FieldError: ({ children }: { children?: React.ReactNode }) =>
+      React.createElement("div", { role: "alert" }, children),
+    Switch: passthrough,
+    RadioGroup: passthrough,
+    RadioGroupItem: passthrough,
+    Dialog: passthrough,
+    DialogBody: passthrough,
+    DialogSection: passthrough,
+    DialogContent: passthrough,
+    DialogFooter: passthrough,
+    DialogHeader: passthrough,
+    DialogTitle: passthrough,
+    getBytes: () => assert.fail("Unrequested quota calculation"),
+    cn: (...values: unknown[]) => values.filter(Boolean).join(" "),
+  })
+
+  const container = document.createElement("div")
+  document.body.appendChild(container)
+  const root = createRoot(container)
+  t.after(async () => {
+    await React.act(async () => root.unmount())
+    await browser.happyDOM.close()
+    Reflect.deleteProperty(globalThis, mocksKey)
+    for (const [key, descriptor] of descriptors) {
+      if (descriptor) Object.defineProperty(globalThis, key, descriptor)
+      else Reflect.deleteProperty(globalThis, key)
+    }
+  })
+  await React.act(async () => root.render(React.createElement(BucketNewForm, { show: true, onShowChange() {} })))
+
+  return {
+    errors,
+    requests,
+    get disabled() {
+      return submitDisabled
+    },
+    get feedback() {
+      return [...container.querySelectorAll('[role="alert"]')].map((element) => element.textContent).join(" ")
+    },
+    async enterName(value: string) {
+      assert.ok(changeName)
+      await React.act(async () => changeName!({ target: { value } }))
+    },
+    async create() {
+      assert.ok(submit)
+      await React.act(async () => submit!())
+    },
+  }
+}
+
+test("the create form enables only an entered name inside the allowed namespace", async (t) => {
+  const form = await mountForm(t)
+  assert.equal(form.disabled, true)
+  await form.enterName("alice-photos")
+  assert.equal(form.disabled, false)
+  assert.equal(form.feedback.includes("Access Denied"), false)
+  await form.create()
+  assert.deepEqual(form.requests, [{ Bucket: "alice-photos", ObjectLockEnabledForBucket: false }])
+})
+
+test("the create form rejects lookalike names visibly without issuing an S3 request", async (t) => {
+  const form = await mountForm(t)
+  await form.enterName("alice2-photos")
+  assert.equal(form.disabled, true)
+  assert.equal(form.feedback.includes("Access Denied"), true)
+  await form.create()
+  assert.deepEqual(form.errors, ["Access Denied"])
+  assert.deepEqual(form.requests, [])
+})
