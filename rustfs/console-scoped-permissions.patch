diff --git a/tests/hooks/use-bucket-quota.test.ts b/tests/hooks/use-bucket-quota.test.ts
new file mode 100644
index 0000000..11993ef
--- /dev/null
+++ b/tests/hooks/use-bucket-quota.test.ts
@@ -0,0 +1,143 @@
+import test, { type TestContext } from "node:test"
+import assert from "node:assert/strict"
+import { readFileSync } from "node:fs"
+import { act, createElement } from "react"
+import { createRoot } from "react-dom/client"
+import { Window } from "happy-dom"
+import { GetBucketCorsCommand } from "@aws-sdk/client-s3"
+import ts from "typescript"
+import { ApiClient } from "../../lib/api-client"
+import type { useBucket as UseBucket } from "../../hooks/use-bucket"
+
+const mocksKey = Symbol.for("bucket-quota-test-contexts")
+const source = ts.transpileModule(readFileSync(new URL("../../hooks/use-bucket.ts", import.meta.url), "utf8"), {
+  compilerOptions: { module: ts.ModuleKind.ESNext },
+}).outputText
+const testSource = source.replace(/from "([^"]+)"/g, (match, specifier: string) => {
+  const hook =
+    specifier === "@/contexts/api-context" ? "useApi" : specifier === "@/contexts/s3-context" ? "useS3" : null
+  const stub = hook
+    ? `export function ${hook}() { return globalThis[Symbol.for("bucket-quota-test-contexts")].${hook}() }`
+    : null
+  const url = stub
+    ? `data:text/javascript,${encodeURIComponent(stub)}`
+    : specifier.startsWith("@/")
+      ? new URL(`../../${specifier.slice(2)}.ts`, import.meta.url).href
+      : import.meta.resolve(specifier)
+  return `from "${url}"`
+})
+const { useBucket } = (await import(
+  `data:text/javascript,${encodeURIComponent(testSource)}`
+)) as typeof import("../../hooks/use-bucket")
+const corsConfig = { CORSRules: [{ AllowedOrigins: ["http://localhost"], AllowedMethods: ["GET"] }] }
+
+async function mountBucket(t: TestContext, status: number, body: unknown) {
+  const browser = new Window()
+  const globals = { window: browser, document: browser.document, IS_REACT_ACT_ENVIRONMENT: true }
+  const previousDescriptors = Object.keys(globals).map(
+    (key) => [key, Object.getOwnPropertyDescriptor(globalThis, key)] as const,
+  )
+  for (const [key, value] of Object.entries(globals)) {
+    Object.defineProperty(globalThis, key, { configurable: true, writable: true, value })
+  }
+  const handled: number[] = []
+  const requests: { url: string; method: string }[] = []
+  const api = new ApiClient(
+    {
+      fetch: async (input, init) => {
+        requests.push({ url: typeof input === "string" ? input : input.url, method: init?.method ?? "GET" })
+        return Response.json(body, { status })
+      },
+    },
+    {
+      baseUrl: "https://console.test/rustfs/admin/v3",
+      errorHandler: {
+        handle401: async () => {
+          handled.push(401)
+        },
+        handle403: async () => {
+          handled.push(403)
+        },
+        handleServerError: async () => {},
+        handleByStatus: async () => {},
+      },
+    },
+  )
+  Reflect.set(globalThis, mocksKey, {
+    useApi: () => api,
+    useS3: () => ({
+      send: async (command: unknown) => {
+        assert.ok(command instanceof GetBucketCorsCommand)
+        assert.deepEqual(command.input, { Bucket: "alice-photos" })
+        return corsConfig
+      },
+    }),
+  })
+  const current: { bucket?: ReturnType<typeof UseBucket> } = {}
+  function Probe() {
+    current.bucket = useBucket()
+    return null
+  }
+  const container = document.createElement("div")
+  document.body.appendChild(container)
+  const root = createRoot(container)
+  t.after(async () => {
+    await act(async () => root.unmount())
+    await browser.happyDOM.close()
+    Reflect.deleteProperty(globalThis, mocksKey)
+    for (const [key, descriptor] of previousDescriptors) {
+      if (descriptor) Object.defineProperty(globalThis, key, descriptor)
+      else Reflect.deleteProperty(globalThis, key)
+    }
+  })
+  await act(async () => root.render(createElement(Probe)))
+  assert.ok(current.bucket)
+  return { bucket: current.bucket, handled, requests }
+}
+
+test("a denied quota read remains a local error while permitted bucket settings load", async (t) => {
+  const { bucket, handled, requests } = await mountBucket(t, 403, {
+    code: "AccessDenied",
+    message: "Quota access denied",
+  })
+  const [quota, cors] = await Promise.allSettled([
+    bucket.getBucketQuota("alice-photos"),
+    bucket.getBucketCors("alice-photos"),
+  ])
+  assert.equal(quota.status, "rejected")
+  if (quota.status !== "rejected") throw new Error("Quota denial was swallowed")
+  assert.equal(quota.reason.status, 403)
+  assert.equal(quota.reason.code, "AccessDenied")
+  assert.deepEqual(cors, { status: "fulfilled", value: corsConfig })
+  assert.deepEqual(handled, [])
+  assert.deepEqual(requests, [{ url: "https://console.test/rustfs/admin/v3/quota/alice-photos", method: "GET" }])
+})
+
+test("quota read suppression does not disable forbidden handling for quota writes", async (t) => {
+  const { bucket, handled } = await mountBucket(t, 403, { code: "AccessDenied", message: "Access denied" })
+  await assert.rejects(bucket.getBucketQuota("alice-photos"), { status: 403 })
+  handled.length = 0
+  await assert.rejects(bucket.putBucketQuota("alice-photos", { quota: 1024 }), { status: 403 })
+  assert.deepEqual(handled, [403])
+})
+
+test("an unauthenticated quota read still invokes authentication handling", async (t) => {
+  const { bucket, handled } = await mountBucket(t, 401, { message: "Session expired" })
+  await assert.rejects(bucket.getBucketQuota("alice-photos"), { status: 401, message: "Session expired" })
+  assert.deepEqual(handled, [401])
+})
+
+for (const status of [404, 500]) {
+  test(`quota HTTP ${status} remains an error rather than an empty configuration`, async (t) => {
+    const { bucket, handled } = await mountBucket(t, status, { message: `HTTP ${status}` })
+    await assert.rejects(bucket.getBucketQuota("alice-photos"), { status, message: `HTTP ${status}` })
+    assert.deepEqual(handled, [])
+  })
+}
+
+test("an authorized quota read preserves the response", async (t) => {
+  const expected = { quota: 1048576, type: "hard" }
+  const { bucket, handled } = await mountBucket(t, 200, expected)
+  assert.deepEqual(await bucket.getBucketQuota("alice-photos"), expected)
+  assert.deepEqual(handled, [])
+})
