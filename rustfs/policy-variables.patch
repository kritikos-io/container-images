diff --git a/crates/policy/src/policy/resource.rs b/crates/policy/src/policy/resource.rs
index 262b13f..cf17fef 100644
--- a/crates/policy/src/policy/resource.rs
+++ b/crates/policy/src/policy/resource.rs
@@ -396,4 +396,36 @@ mod tests {
         let round_trip: ResourceSet = serde_json::from_str(&json).expect("serialized set should deserialize");
         assert_eq!(round_trip, set);
     }
+
+    #[test_case("arn:aws:s3:::mybucket/${jwt:preferred_username}/*", "mybucket/alice/photo.jpg" => true; "jwt variable")]
+    #[test_case("arn:aws:s3:::mybucket/${jwt:preferred_username}/*", "mybucket/bob/photo.jpg" => false; "jwt variable other user")]
+    #[test_case("arn:aws:s3:::mybucket/${ldap:username}/*", "mybucket/alice-ldap/photo.jpg" => true; "ldap variable")]
+    #[test_case("arn:aws:s3:::${jwt:preferred_username}-*", "alice-photos" => true; "own bucket")]
+    #[test_case("arn:aws:s3:::${jwt:preferred_username}-*", "bob-photos" => false; "other user bucket")]
+    #[test_case("arn:aws:s3:::${jwt:preferred_username}-*", "alice2-photos" => false; "lookalike username bucket")]
+    #[test_case("arn:aws:s3:::${jwt:preferred_username}-*", "alice" => false; "bucket without namespace separator")]
+    #[test_case("arn:aws:s3:::${jwt:preferred_username}-*/*", "alice-photos/photo.jpg" => true; "own object")]
+    #[test_case("arn:aws:s3:::${jwt:preferred_username}-*/*", "bob-photos/photo.jpg" => false; "other user object")]
+    #[test_case("arn:aws:s3:::${jwt:preferred_username}-*/*", "alice2-photos/photo.jpg" => false; "lookalike username object")]
+    fn test_resource_is_match_substitutes_condition_variables(resource: &str, object: &str) -> bool {
+        let resource: Resource = resource.try_into().unwrap();
+        let conditions = HashMap::from([
+            ("preferred_username".to_string(), vec!["alice".to_string()]),
+            ("username".to_string(), vec!["alice-ldap".to_string()]),
+        ]);
+
+        pollster::block_on(resource.is_match(object, &conditions))
+    }
+
+    #[test_case("arn:aws:s3:::${jwt:preferred_username}-*", "alice-photos"; "bucket requires username")]
+    #[test_case("arn:aws:s3:::${jwt:preferred_username}-*/*", "alice-photos/photo.jpg"; "object requires username")]
+    fn test_resource_namespace_requires_username(resource: &str, object: &str) {
+        let resource: Resource = resource.try_into().unwrap();
+        for conditions in [
+            HashMap::new(),
+            HashMap::from([("preferred_username".to_string(), vec![String::new()])]),
+        ] {
+            assert!(!pollster::block_on(resource.is_match(object, &conditions)));
+        }
+    }
 }
